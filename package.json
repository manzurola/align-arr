{
  "name": "align-arr",
  "version": "2.0.0",
  "description": "Find the minimal edit path between two generic arrays.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manzurola/align-arr.git"
  },
  "author": "manzurola <guy.manzurola@gmail.com>",
  "license": "MIT",
  "private": false,
  "keywords": [
    "alignment",
    "edit-distance",
    "levenshtein",
    "similarity",
    "diff"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "yarn lint && jest",
    "coverage": "c8 --reporter=lcov --reporter=text yarn test",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "c8": "^10.1.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "lib/**/*"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
